# Configuración del Servidor
NODE_ENV=development
PORT=3005

# Base de Datos PostgreSQL
# Si el puerto 5432 falla, intenta con el 5436 que viste en pgAdmin
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=GestionOpinionesDB
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_SQL_LOGGING=true

# Configuración de JWT
# Clave robusta para la firma de tokens
JWT_SECRET=MyVerySecretKeyForJWTTokenAuthenticationWith256Bits!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=OpinionsService
JWT_AUDIENCE=OpinionsService

# Seguridad y CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173